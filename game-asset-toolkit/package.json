{
  "name": "game-asset-toolkit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node src/tools/image-compressor/scripts/prepare.mjs && next dev",
    "build": "node src/tools/image-compressor/scripts/prepare.mjs && next build && node src/tools/image-compressor/scripts/offline-manifest.mjs",
    "start": "next start",
    "lint": "next lint",
    "prepare:image-compressor": "node src/tools/image-compressor/scripts/prepare.mjs",
    "test:image-compressor": "node src/tools/image-compressor/scripts/prepare.mjs && node --test src/tools/image-compressor/tests/*.test.mjs",
    "postinstall": "node src/tools/image-compressor/scripts/prepare.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/jxl": "1.3.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/webp": "1.5.0",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
